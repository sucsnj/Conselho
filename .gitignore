# ==========================================
# .gitignore - A Corte de ADS (Raiz do Projeto)
# ==========================================

# 1. Dependências (Node / NPM)
node_modules/
**/node_modules/
package-lock.json.bak
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 2. Variáveis de Ambiente e Segredos (CRÍTICO)
# Ignora todos os arquivos de ambiente reais, preservando apenas exemplos
.env
.env.*
!.env.example
*.local
*.pem
*.key
*.cert
*.pfx
*.p12

# 3. Bancos de Dados e Dados em Tempo de Execução (SQLite / DBs)
# Garante que dados de votos, participantes e senhas não subam
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
data/*.db
data/*.db-wal
data/*.db-shm

# 4. Compilação e Builds de Produção
dist/
dist-ssr/
build/
out/
.vite/
.next/
.cache/

# 5. Logs e Depuração
logs/
*.log

# 6. Configurações de IDE e Editores de Código
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# 7. Arquivos do Sistema Operacional
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
